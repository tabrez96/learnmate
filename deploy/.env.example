# Cloudflare: token of the named tunnel (Zero Trust > Networks > Tunnels > your tunnel > Docker command)
CLOUDFLARE_TUNNEL_TOKEN=

# App-to-server token; the same value goes into android/local.properties as learnmate.deviceToken.
# Make one with: openssl rand -hex 32
DEVICE_TOKEN=

# AI
ANTHROPIC_API_KEY=
# Monthly AI spending cap in USD; Telegram alerts at 80% and 100%, no new lessons or reading at 100%.
LLM_MONTHLY_BUDGET_USD=10

# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=
# IANA time zone for message times and the budget month, e.g. Europe/London
TIMEZONE=UTC
# Nightly backup hour (0-23, in TIMEZONE); backups are kept 14 days. See "Backups" in README.md.
BACKUP_HOUR=3

# Fernet key that encrypts the stored session PIN; empty keeps a key file in data/.
# Make one with: docker compose run --rm server python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PIN_KEY=

# Retrieval. After changing EMBED_MODEL, follow "Switching the embedding model" in README.md.
EMBED_MODEL=BAAI/bge-small-en-v1.5
RERANK_ENABLED=false
