root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true

[*.{kt,kts}]
# Compose names @Composable functions in PascalCase (LearnmateApp), which ktlint's
# function-naming rule would reject, so the rule skips functions with that annotation.
ktlint_function_naming_ignore_when_annotated_with = Composable
